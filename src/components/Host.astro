---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../data/site';

const logoPath = '/logos/fsec-ss.png';
// Resolve against the project root; import.meta.url points inside dist/ during prerender.
const hasLogo = existsSync(join(process.cwd(), 'public', logoPath));

// PLACEHOLDER: replace with the club's official mission statement.
const mission = [
  'Give APU students a place to practise offensive and defensive security on real challenges.',
  'Run Battle of Hackers every year as a fair, well-built competition for local and international teams.',
  'Grow forensic and cybersecurity research skills through workshops, talks and study groups.',
  'Connect students with the industry partners who sponsor and judge the competition.',
];
---

<section id="host" class="mx-auto max-w-7xl px-5 py-24 md:px-10">
  <div class="grid gap-14 lg:grid-cols-[2fr_3fr]">
    <div class="reveal">
      <p class="eyebrow flex items-center gap-3 text-red">
        <span class="block size-1.5 rounded-full bg-red" aria-hidden="true"></span>
        Hosted by
      </p>
      <div class="mt-6 flex items-center gap-5">
        {
          hasLogo && (
            <img src={logoPath} alt="" width="197" height="197" class="size-16 shrink-0" />
          )
        }
        <h2 class="font-display text-4xl font-bold leading-tight tracking-[-0.02em] text-fg md:text-5xl">
          {site.host.short}
        </h2>
      </div>
      <p class="mt-4 text-cyan">{site.host.full}</p>
      <!-- PLACEHOLDER: replace with the club's official description. -->
      <p class="mt-6 max-w-prose leading-relaxed text-fg-muted">
        FSEC-SS is the student arm of the Forensic and Cybersecurity Research Centre at Asia
        Pacific University. Its members design the challenges, build the infrastructure and run
        the floor on competition day, then spend the rest of the year sharpening the skills that
        go into the next one.
      </p>
    </div>

    <div class="reveal">
      <h3 class="eyebrow text-fg-muted">What we set out to do</h3>
      <ol class="mt-4 border-t border-hair">
        {
          mission.map((m, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-hair py-6">
              <span class="eyebrow pt-1.5 text-cyan">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-xl leading-snug text-fg md:text-2xl">{m}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

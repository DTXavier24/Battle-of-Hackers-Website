---
import JoinButton from './JoinButton.astro';

const items = [
  { href: '#about', label: 'About' },
  { href: '#iboh-2026', label: 'IBOH 2026' },
  { href: '#history', label: 'History' },
  { href: '#host', label: 'Host' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 h-[58px] border-b border-hair bg-bg/70 backdrop-blur-[14px]"
>
  <nav
    aria-label="Main"
    class="mx-auto flex h-full max-w-7xl items-center justify-between gap-6 px-5 md:px-10"
  >
    <a href="#home" class="font-display text-[15px] font-bold uppercase tracking-tight text-fg">
      Battle of Hackers<span class="text-red">.</span>
    </a>

    <ul data-rail class="hidden items-center gap-8 md:flex">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class="eyebrow text-fg-muted transition-colors hover:text-red data-active:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <JoinButton class="btn-sm" />
  </nav>
</header>

<script>
  import { initRail } from '../scripts/rail';
  initRail();
</script>

---
import { site } from '../data/site';

const { prizes, event } = site;

const rm = (n: number) => `RM${n.toLocaleString('en-MY')}`;
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};

const pool = prizes.reduce((sum, b) => sum + b.ranks.reduce((s, r) => s + r.value, 0), 0);
---

<section id="prizes" class="mx-auto max-w-7xl px-5 py-24 md:px-10">
  <div class="reveal flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow flex items-center gap-3 text-red">
        <span class="block size-1.5 rounded-full bg-red" aria-hidden="true"></span>
        Prizes
      </p>
      <h2 class="mt-6 font-display text-4xl font-bold leading-tight tracking-[-0.02em] text-fg md:text-5xl">
        Top 10 get paid
      </h2>
      <p class="mt-6 max-w-[52ch] leading-relaxed text-fg-muted">
        This year we reward the top 10 teams in both the International and Local boards. Push
        for the podium and OffSec PGP subscriptions and CPSA vouchers are waiting too.
      </p>
    </div>
    <div class="text-right">
      <p class="eyebrow text-fg-muted">Total prize value</p>
      <p class="mt-2 font-display text-4xl font-bold tracking-[-0.02em] text-cyan md:text-5xl">
        {rm(pool)}
      </p>
    </div>
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-3">
    {
      prizes.map((b) => (
        <article class="reveal hud flex flex-col bg-bg-2 p-6 md:p-8">
          <header class="border-b border-hair pb-5">
            <span class="eyebrow block text-red">{b.category}</span>
            <h3 class="mt-1 font-display text-2xl font-semibold leading-tight text-fg">
              {b.board}
            </h3>
            <span class="eyebrow mt-3 block text-fg-muted">
              {rm(b.ranks.reduce((s, r) => s + r.value, 0))} across {b.ranks.length} places
            </span>
          </header>

          <ol class="mt-2">
            {b.ranks.map((r, i) =>
              i < 3 ? (
                <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-hair py-5">
                  <span class="numeral text-4xl">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <span class="sr-only">{ordinal(i + 1)} place: </span>
                    <span class="block font-display text-3xl font-bold leading-none text-fg">
                      {rm(r.value)}
                    </span>
                    <span class="mt-2 block text-sm leading-relaxed text-fg-muted">
                      {r.cash > 0 && `${rm(r.cash)} cash`}
                      {r.cash > 0 && r.extra && ' + '}
                      {r.extra && <span class="text-cyan">{r.extra}</span>}
                    </span>
                  </div>
                </li>
              ) : (
                <li class="grid grid-cols-[3rem_1fr_auto] items-baseline gap-4 border-b border-hair py-3 last:border-b-0">
                  <span class="eyebrow text-cyan">{ordinal(i + 1)}</span>
                  <span class="text-sm text-fg-muted">
                    {r.extra ? <span class="text-cyan">{r.extra}</span> : 'Cash'}
                  </span>
                  <span class="font-display text-lg font-semibold text-fg">{rm(r.value)}</span>
                </li>
              ),
            )}
          </ol>
        </article>
      ))
    }
  </div>
  <p class="mt-6 text-sm text-fg-muted">
    Totals include the stated value of subscriptions and vouchers. Prizes for IBOH {event.year}.
  </p>
</section>

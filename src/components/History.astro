---
import data from '../data/timeline.json';
import { validateTimeline } from '../data/timeline.schema';
import TimelineEntry from './TimelineEntry.astro';

const entries = validateTimeline(data);
---

<section id="history" class="mx-auto max-w-7xl px-5 py-24 md:px-10">
  <div class="reveal max-w-2xl">
    <p class="eyebrow flex items-center gap-3 text-cyan">
      <span class="block size-1.5 rounded-full bg-cyan" aria-hidden="true"></span>
      History
    </p>
    <h2 class="mt-6 font-display text-4xl font-bold leading-tight tracking-[-0.02em] text-fg md:text-5xl">
      A decade of battles
    </h2>
    <p class="mt-4 leading-relaxed text-fg-muted">
      From an internal contest for APU students to an international competition. Each edition
      raised the bar for the next.
    </p>
  </div>

  <ol
    class="relative mt-16 grid gap-12 before:absolute before:bottom-0 before:left-4 before:top-0 before:w-px before:bg-line md:gap-0 md:before:left-1/2 md:before:-translate-x-1/2"
  >
    {entries.map((entry, index) => <TimelineEntry entry={entry} index={index} />)}
  </ol>
</section>

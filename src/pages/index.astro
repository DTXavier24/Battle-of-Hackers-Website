---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Portal from '../components/Portal.astro';
import Statement from '../components/Statement.astro';
import Register from '../components/Register.astro';
import Terms from '../components/Terms.astro';
import History from '../components/History.astro';
import Host from '../components/Host.astro';
import Close from '../components/Close.astro';
import Mascot from '../components/Mascot.astro';
import CursorTrail from '../components/CursorTrail.astro';
import DotGlow from '../components/DotGlow.astro';
---

<Base
  title="APU Battle of Hackers"
  description="The annual capture-the-flag competition hosted by FSEC-SS at Asia Pacific University. 14 November 2026: Jeopardy runs hybrid, Attack & Defense on campus. Open to local and international students."
>
  <DotGlow slot="nav" />
  <Nav slot="nav" />
  <Portal />
  <Statement />
  <Register />
  <Terms />
  <History />
  <Host />
  <Mascot />
  <CursorTrail />
  <Close slot="footer" />
</Base>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
